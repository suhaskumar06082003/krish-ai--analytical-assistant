# Local sandbox only - dummy credentials for the SQL Server container in docker-compose.yml.
SQL_SERVER=mssql
SQL_DATABASE=HangyoDev
SQL_USERNAME=mcp_reader
SQL_PASSWORD=Reader#Pass2026
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=30
SQL_CONNECTION_RETRIES=3

FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
MCP_TRANSPORT=streamable-http
MCP_METADATA_ON_STARTUP=true
MCP_FAIL_ON_STARTUP_METADATA=true
LOG_LEVEL=INFO
