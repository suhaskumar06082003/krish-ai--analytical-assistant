# Azure SQL connection
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your_database
SQL_USERNAME=readonly_user
SQL_PASSWORD=change_me
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Optional Azure SQL connection tuning
SQL_PORT=1433
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
SQL_CONNECTION_TIMEOUT=120
SQL_CONNECTION_RETRIES=3
SQL_CONNECTION_RETRY_DELAY_SECONDS=5
SQL_QUERY_TIMEOUT=120

# MCP runtime
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_JSON_RESPONSE=true
MCP_TRANSPORT=streamable-http
MCP_DEFAULT_ROW_LIMIT=100
MCP_MAX_ROW_LIMIT=1000
MCP_MAX_RESPONSE_COLUMNS=50
MCP_MAX_RESPONSE_CELLS=20000
MCP_LARGE_TABLE_ROW_THRESHOLD=50000
MCP_ENABLE_EXACT_OUTPUT_COUNT=true
MCP_SAMPLE_ROW_LIMIT=5
MCP_ARTIFACT_DIR=.
MCP_METADATA_ON_STARTUP=true
MCP_FAIL_ON_STARTUP_METADATA=false

# Optional MCP HTTP bearer-token auth.
# For public ingress, set MCP_BEARER_TOKEN and MCP_PUBLIC_URL.
# MCP_PUBLIC_URL should be the externally reachable MCP URL, for example:
# https://your-container-app.region.azurecontainerapps.io/mcp
MCP_BEARER_TOKEN=
MCP_PUBLIC_URL=
MCP_AUTH_ISSUER_URL=
MCP_AUTH_TENANT_ID=
MCP_AUTH_CLIENT_ID=
MCP_AUTH_AUDIENCE=
MCP_REQUIRED_SCOPE=sql.read

# Logging
LOG_LEVEL=INFO
